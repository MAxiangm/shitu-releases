{
  "name": "shitu",
  "productName": "拾图",
  "version": "0.10.8",
  "description": "A local-first image library for Windows",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "node scripts/start.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node scripts/smoke.cjs",
    "package": "node scripts/package.cjs",
    "installer": "node scripts/build-installer.cjs",
    "sync:installer": "node scripts/sync-installer.cjs",
    "release:github": "node scripts/publish-github.cjs",
