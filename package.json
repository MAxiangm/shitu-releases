{
  "name": "shitu",
  "productName": "Mosaic",
  "version": "0.29.29",
  "description": "A local-first creative asset library for Windows",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "node scripts/start.cjs",
    "check": "node scripts/check.cjs",
