    "package": "node scripts/package.cjs",
    "installer": "node scripts/build-installer.cjs",
    "sync:installer": "node scripts/sync-installer.cjs",
    "release:github": "node scripts/publish-github.cjs --publish",
    "release:draft": "node scripts/publish-github.cjs",
    "prepare:resources": "node scripts/prepare-build-resources.cjs",
    "test:updates": "node scripts/smoke-update.cjs",
    "test:updates:live": "node scripts/smoke-update-live.cjs",
    "test:folders": "node scripts/smoke-folders.cjs",
    "test:folder-panel": "node scripts/smoke-folder-panel.cjs",
    "test:fonts": "node scripts/smoke-font.cjs",
    "test:organize": "node scripts/smoke-organize.cjs",
    "test:skins": "node scripts/smoke-skins.cjs",
    "test:window-header": "node scripts/smoke-window-header.cjs",
    "test:drag": "node scripts/smoke-asset-drag.cjs",
    "test:colors": "node scripts/smoke-colors.cjs",
    "test:video": "node scripts/smoke-video.cjs",
    "test:transcode": "node scripts/smoke-transcode.cjs",
    "test:ui-recovery": "node scripts/smoke-ui-recovery.cjs",
    "test:undo": "node scripts/smoke-undo.cjs",
    "test:video:hover": "node scripts/smoke-hover-video.cjs",
    "test:models": "node scripts/smoke-model.cjs",
    "test:sketchfab": "node scripts/smoke-sketchfab-viewer.cjs",
    "test:sketchfab:live": "node scripts/smoke-sketchfab-viewer.cjs --live",
    "test:collector": "node scripts/smoke-collector.cjs",
    "test:ae": "node scripts/smoke-ae.cjs",
    "test:bundles": "node scripts/smoke-bundle.cjs",
    "prepare:video": "node scripts/prepare-video-runtime.cjs",
    "prepare:youtube": "node scripts/prepare-youtube-runtime.cjs"
