{
  "manifest_version": 3,
  "name": "拾图采集助手",
  "version": "0.11.1",
  "description": "按住 Alt 并右键点击网页图片或直链视频，保存到本机拾图素材库。",
  "key": "",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }],
  "action": { "default_title": "拾图采集助手", "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}
