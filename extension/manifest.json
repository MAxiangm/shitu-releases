{
  "manifest_version": 3,
  "name": "Mosaic 采集助手",
  "version": "0.11.19",
  "description": "按住 Alt 并右键点击网页图片或可下载的视频，将文件保存到本机 Mosaic 素材库。",
  "key": "",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
    "js": ["network-video-metadata.js"],
    "world": "MAIN",
    "all_frames": true,
    "run_at": "document_start"
  }, {
    "matches": ["https://vimeo.com/*", "https://www.vimeo.com/*", "https://player.vimeo.com/*"],
    "js": ["vimeo-network-metadata.js"],
    "world": "MAIN",
    "all_frames": true,
    "run_at": "document_start"
  }, {
    "matches": ["http://*/*", "https://*/*"],
    "js": ["social-instagram.js", "social-x.js", "social-vimeo.js", "social-pinterest.js", "content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }],
  "action": { "default_title": "Mosaic 采集助手", "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}
